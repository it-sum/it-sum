# IT-SUM complete environment reference
# Copy values into the correct deployment environment; never commit a real .env file.
# Public values are filled when confirmed. Secret values remain placeholders by design.

# -----------------------------------------------------------------------------
# Frontend: apps/web (Vercel-safe public variables)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Set these only after the NestJS API has a public HTTPS URL.
# NEXT_PUBLIC_API_MODE=live
# NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_DOMAIN.example/api/v1
# NEXT_PUBLIC_API_ORIGIN=https://YOUR_API_DOMAIN.example

# -----------------------------------------------------------------------------
# NestJS API: apps/api
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
SERVICE_VERSION=0.1.0
PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,https://it-sum-next.vercel.app

# -----------------------------------------------------------------------------
# Supabase project: it-sum / ztujhryukdddhjymhfod
# -----------------------------------------------------------------------------
SUPABASE_URL=https://ztujhryukdddhjymhfod.supabase.co
SUPABASE_JWKS_URL=https://ztujhryukdddhjymhfod.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://ztujhryukdddhjymhfod.supabase.co/auth/v1
# Compatibility name used by the alternate backend handoff; use the name required by your API build.
SUPABASE_ISSUER=https://ztujhryukdddhjymhfod.supabase.co/auth/v1
# Secret: Supabase Dashboard > Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SERVER_SECRET_MANAGER

# -----------------------------------------------------------------------------
# Google Drive and OAuth
# -----------------------------------------------------------------------------
DRIVE_MODE=oauth_user
DRIVE_ROOT_FOLDER_ID=10bpMPWKQ4EJ6UWEBwysqNdTEC6Tsh6B2
GOOGLE_CLIENT_ID=39929218812-3jfqrs4mnau4co2j7usecauvdim62orq.apps.googleusercontent.com
# Secret: Google Cloud Console > APIs & Services > Credentials > OAuth client.
GOOGLE_CLIENT_SECRET=REPLACE_IN_SERVER_SECRET_MANAGER
# Secret: obtain by completing the OAuth consent flow for the Drive owner account.
GOOGLE_REFRESH_TOKEN=REPLACE_IN_SERVER_SECRET_MANAGER
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/drive/oauth/callback
# Production form: https://YOUR_API_DOMAIN.example/api/v1/drive/oauth/callback

# Shared Drive alternative; use instead of OAuth-user mode.
# DRIVE_MODE=shared_drive
GOOGLE_SHARED_DRIVE_ID=REPLACE_IF_USING_SHARED_DRIVE
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_SERVER_SIDE_ONLY_IF_USING_SHARED_DRIVE

# The IT-SUM university UUID used by the current database fixtures.
SYNC_UNIVERSITY_ID=00000000-0000-4000-8000-000000000001

# -----------------------------------------------------------------------------
# PDF/quiz signing, token encryption and automation
# -----------------------------------------------------------------------------
# Generate independent values with: openssl rand -base64 48
STREAM_TICKET_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
QUIZ_ATTEMPT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
INTERNAL_CRON_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
# Used by the alternate backend handoff for encrypted Drive refresh tokens.
DRIVE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
# Compatibility name used by the alternate backend handoff.
STREAM_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
STREAM_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Where to place each value
# -----------------------------------------------------------------------------
# Vercel frontend project: it-sum-next
#   NEXT_PUBLIC_API_MODE=mock
#   NEXT_PUBLIC_DEFAULT_LOCALE=ar
#   NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_DOMAIN.example/api/v1 (live mode only)
#   NEXT_PUBLIC_API_ORIGIN=https://YOUR_API_DOMAIN.example (live mode only)
#
# NestJS API host only:
#   All SUPABASE_*, GOOGLE_*, DRIVE_*, *_SECRET, *_KEY and token variables above.
#   Do not put service_role, refresh tokens, client secrets or signing secrets in GitHub.
#
# Google Cloud OAuth configuration:
#   Add the local callback and the production callback to Authorized redirect URIs.
#   Local:      http://localhost:3001/api/v1/drive/oauth/callback
#   Production: https://YOUR_API_DOMAIN.example/api/v1/drive/oauth/callback
