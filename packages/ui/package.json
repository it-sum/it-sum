{
  "name": "@it-sum/ui",
  "version": "0.1.0",
  "private": true,
  "description": "IT-SUM design system: Material Design 3 token layer, Tailwind preset and accessible bilingual components",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./tokens": "./src/tokens/index.ts",
    "./tailwind-preset": "./src/styles/preset.css"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage",
    "tokens": "tsx scripts/generate-tokens.ts",
    "build": "pnpm tokens"
  },
  "dependencies": {
    "@it-sum/shared": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@it-sum/config": "workspace:*",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "react": "19.2.8",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@material/material-color-utilities": "^0.4.0",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
